PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string.
# For remote/managed PostgreSQL always include SSL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/firstsavvydb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/firstsavvydb?sslmode=require

# Connection pool tuning (optional)
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# Auth/session configuration.
# Production must set long random secrets. Development has non-production fallbacks.
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_PASSWORD_RESET_SECRET=replace-with-long-random-password-reset-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=firstsavvy_refresh
ADMIN_REFRESH_COOKIE_NAME=firstsavvy_admin_refresh
# Set to a unique random secret of at least 32 characters before one-time admin setup.
# Keep the value in your deployment secret manager; never commit the real secret.
ADMIN_BOOTSTRAP_SECRET=
COOKIE_SECURE=false
PASSWORD_RESET_TTL_MINUTES=30

# Google OAuth. Redirect URL must be allowed in the Google Cloud OAuth client.
OAUTH_STATE_COOKIE_NAME=firstsavvy_oauth_state
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:5000/api/v1/auth/google/callback
GOOGLE_OAUTH_SUCCESS_REDIRECT_URL=http://localhost:5173/auth/callback
GOOGLE_OAUTH_FAILURE_REDIRECT_URL=http://localhost:5173/login

# SMTP email delivery. Forgot-password emails are skipped in development if SMTP_HOST is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FirstSavvy <no-reply@firstsavvy.com>
MAIL_API_KEY=mail_api_key
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Plaid Integration. Use the Plaid sandbox for development.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US,CA
PLAID_REDIRECT_URI=http://localhost:5173/Integrations

# AWS S3 Integration. Use the AWS S3 service for file storage.
AWS_S3_UPLOAD_MAX_BYTES=
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=
AWS_S3_PUBLIC_BASE_URL=

# Development-only logging (optional; secrets are always redacted when logged)
LOG_DEV_REQUESTS=true
# LOG_DEV_REQUEST_BODY=true
# LOG_DEV_RESPONSE_BODY=true

# Global API rate limiting (per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
TRUST_PROXY=true # Set true behind nginx/load balancer so the real client IP is used

# Credit score monitoring (mock provider until bureau credentials are available)
CREDIT_PROVIDER=mock
MOCK_KYC_RESULT=verified
CREDIT_AUTO_PULL_ENABLED=false
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# TWILIO VARIABLES
TWILIO_ACCOUNT_SID = 
TWILIO_AUTH_TOKEN = 
TWILIO_VERIFY_SERVICE_SID = 