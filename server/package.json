{
  "name": "firstsavvy-server",
  "version": "1.0.0",
  "description": "FirstSavvy custom Node.js backend foundation",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:status": "prisma migrate status",
    "db:seed": "node prisma/seed.js",
    "calendar:run": "node workers/calendarScheduler.js",
    "credit:run": "node workers/creditScheduler.js",
    "script:verify-credit-score": "node scripts/verify-credit-score.js",
    "script:verify-provisioning": "node scripts/verify-provisioning.js",
    "script:verify-api-standards": "node scripts/verify-api-standards.js",
    "script:verify-auth-standards": "node scripts/verify-auth-standards.js",
    "script:verify-profile-standards": "node scripts/verify-profile-standards.js",
    "script:verify-profile-authorization": "node scripts/verify-profile-authorization.js",
    "script:verify-sanitize": "node scripts/verify-sanitize.js",
    "script:bootstrap": "node scripts/db-bootstrap.js",
    "script:reset-schema": "node scripts/reset-db-schema.js",
    "docs:export": "node scripts/export-openapi.js",
    "script:verify-swagger": "node scripts/verify-swagger-routes.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "otplib": "^12.0.1",
    "pg": "^8.21.0",
    "plaid": "^43.0.0",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "prisma": "^7.8.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
