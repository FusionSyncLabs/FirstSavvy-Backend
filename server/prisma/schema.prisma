generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                  String                   @id @default(uuid()) @db.Uuid
  email                               String                   @unique @db.VarChar(320)
  password_hash                       String?
  full_name                           String?                  @db.VarChar(255)
  avatar_url                          String?
  verified_at                         DateTime?                @db.Timestamptz(6)
  google_id                           String?                  @unique @db.VarChar(255)
  refresh_token_version               Int                      @default(0)
  created_at                          DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                          DateTime                 @updatedAt @db.Timestamptz(6)
  deleted_at                          DateTime?                @db.Timestamptz(6)
  password_reset_token_hash           String?                  @db.VarChar(128)
  referral_code                       String?                  @db.VarChar(50)
  user_name                           String                   @unique @db.VarChar(40)
  unique_id                           String                   @unique @db.VarChar(20)
  phone_number                        String?                  @unique @db.VarChar(20)
  phone_verified_at                   DateTime?                @db.Timestamptz(6)
  two_factor_enabled                  Boolean                  @default(false)
  two_factor_method                   String?                  @db.VarChar(50)
  two_factor_secret                   String?                  @db.VarChar(255)
  two_factor_backup_codes             String[]                 @default([])
  allowance_schedules_created         AllowanceSchedule[]      @relation("AllowanceCreatedBy")
  audit_logs                          AuditLog[]
  calendar_notifications_acknowledged CalendarNotification[]   @relation("CalendarNotificationAcknowledgedBy")
  child_profiles_as_parent            ChildProfile[]           @relation("ChildParentUser")
  child_transactions_approved         ChildTransaction[]       @relation("ChildTransactionApprovedBy")
  configuration_changes               ConfigurationChangeLog[]
  credit_verifications                CreditVerification[]
  documents_uploaded                  Document[]
  journal_entries_created             JournalEntry[]           @relation("JournalEntryCreatedBy")
  journal_entry_attachments           JournalEntryAttachment[]
  notifications_read                  Notification[]           @relation("NotificationReadBy")
  notifications_received              Notification[]           @relation("NotificationRecipient")
  otp_verifications                   OtpVerification[]
  parent_access_grants                ParentAccessGrant[]      @relation("ParentAccessGrantedBy")
  memberships                         ProfileMembership[]
  profile_tabs                        ProfileTab[]
  owned_profiles                      Profile?                 @relation("ProfileOwner")
  protected_configs_created           ProtectedConfiguration[] @relation("ProtectedConfigCreatedBy")
  protected_configs_updated           ProtectedConfiguration[] @relation("ProtectedConfigUpdatedBy")
  recurring_schedules_created         RecurringSchedule[]      @relation("RecurringScheduleCreatedBy")
  referrals                           Referral[]
  reward_redemptions_approved         RewardRedemption[]       @relation("RewardRedemptionApprovedBy")
  reward_redemptions_fulfilled        RewardRedemption[]       @relation("RewardRedemptionFulfilledBy")
  rewards_created                     Reward[]                 @relation("RewardCreatedBy")
  secret_keys                         SecretKey[]
  task_completions_reviewed           TaskCompletion[]         @relation("TaskCompletionReviewedBy")
  tasks_approved                      Task[]                   @relation("TaskApprovedBy")
  tasks_created                       Task[]                   @relation("TaskCreatedBy")
  user_setting                        UserSetting?
  vault_items                         VaultItem[]
  vault_shares_sent                   VaultShare[]             @relation("VaultShareSender")
  vault_shares_received               VaultShare[]             @relation("VaultShareRecipient")
  phone_verifications                 PhoneVerification[]
  two_factor_verifications            TwoFactorVerification[]

  @@index([user_name])
  @@index([unique_id])
  @@index([deleted_at])
  @@index([referral_code])
  @@index([phone_number])
  @@index([two_factor_enabled])
  @@map("users")
}

model OtpVerification {
  id         String                @id @default(uuid()) @db.Uuid
  otp        String
  email      String                @db.VarChar(320)
  expires_at DateTime              @db.Timestamptz(6)
  attempts   Int?                  @default(0)
  created_at DateTime              @default(now()) @db.Timestamptz(6)
  updated_at DateTime              @updatedAt @db.Timestamptz(6)
  status     OtpVerificationStatus @default(pending)
  user_id    String                @db.Uuid
  user       User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([otp])
  @@map("otp_verifications")
}

model PhoneVerification {
  id         String                   @id @default(uuid()) @db.Uuid
  phone      String                   @db.VarChar(20)
  code       String                   @db.VarChar(6)
  expires_at DateTime                 @db.Timestamptz(6)
  attempts   Int?                     @default(0)
  created_at DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at DateTime                 @updatedAt @db.Timestamptz(6)
  status     PhoneVerificationStatus  @default(pending)
  user_id    String?                  @db.Uuid
  user       User?                    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([phone])
  @@index([code])
  @@index([status])
  @@map("phone_verifications")
}

model TwoFactorVerification {
  id         String                  @id @default(uuid()) @db.Uuid
  user_id    String                  @db.Uuid
  method     String                  @db.VarChar(50)
  code       String                  @db.VarChar(6)
  expires_at DateTime                @db.Timestamptz(6)
  attempts   Int                     @default(0)
  verified   Boolean                 @default(false)
  created_at DateTime                @default(now()) @db.Timestamptz(6)
  updated_at DateTime                @updatedAt @db.Timestamptz(6)
  user       User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([code])
  @@index([expires_at])
  @@map("two_factor_verifications")
}

model SecretKey {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  key_value    String    @unique @db.VarChar(64)
  name         String?   @db.VarChar(100)
  is_active    Boolean   @default(true)
  expires_at   DateTime? @db.Timestamptz(6)
  last_used_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at   DateTime? @db.Timestamptz(6)
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([key_value])
  @@index([is_active])
  @@index([deleted_at])
  @@map("secret_keys")
}

model Profile {
  id                         String                    @id @default(uuid()) @db.Uuid
  owner_user_id              String                    @unique(map: "profiles_one_default_per_owner_idx", where: raw("((is_default = true) AND (deleted_at IS NULL))")) @db.Uuid
  name                       String                    @db.VarChar(255)
  display_name               String?                   @db.VarChar(255)
  profile_type               ProfileType               @default(personal)
  family_role                String?                   @db.VarChar(100)
  avatar_url                 String?
  color                      String?                   @db.VarChar(32)
  is_default                 Boolean                   @default(false)
  is_active                  Boolean                   @default(true)
  metadata                   Json                      @default("{}")
  created_at                 DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                  @updatedAt @db.Timestamptz(6)
  deleted_at                 DateTime?                 @db.Timestamptz(6)
  unique_id                  String                    @unique @db.VarChar(20)
  audit_logs                 AuditLog[]
  budgets                    Budget[]
  calendar_notifications     CalendarNotification[]
  child_profiles             ChildProfile[]
  configuration_changes      ConfigurationChangeLog[]
  contacts                   Contact[]
  credit_scores              CreditScore[]
  credit_verifications       CreditVerification?
  csv_mapping_configs        CsvColumnMappingConfig[]
  documents                  Document[]
  events                     Event[]
  financial_goals            FinancialGoal[]
  goal_contributions         GoalContribution[]
  journal_entries            JournalEntry[]
  journal_entry_attachments  JournalEntryAttachment[]
  meal_plans                 MealPlan[]
  notifications              Notification[]
  parent_access_grants       ParentAccessGrant[]
  payment_reminders          PaymentReminder[]
  plaid_accounts             PlaidAccount[]
  plaid_items                PlaidItem[]
  profile_invitations_sent   ProfileInvitation[]       @relation("ProfileInvitationsSent")
  memberships                ProfileMembership[]
  profile_shares_granted     ProfileShare[]            @relation("ProfileShareGrantedBy")
  profile_shares_received    ProfileShare[]            @relation("ProfileShareReceivedBy")
  profile_tabs               ProfileTab[]
  view_preferences           ProfileViewPreference[]
  owner                      User                      @relation("ProfileOwner", fields: [owner_user_id], references: [id])
  protected_configs          ProtectedConfiguration[]
  recipes                    Recipe[]
  recurring_occurrences      RecurringOccurrence[]
  recurring_schedules        RecurringSchedule[]
  rewards                    Reward[]
  task_templates             TaskTemplate[]
  tasks                      Task[]
  transaction_rules          TransactionRule[]
  transaction_splits         TransactionSplit[]
  transactions               Transaction[]
  transfer_match_suggestions TransferMatchSuggestion[]
  chart_of_accounts          UserChartOfAccount[]
  vault_encryption_key       VaultEncryptionKey?
  vault_folders              VaultFolder[]
  vault_items                VaultItem[]

  @@index([owner_user_id])
  @@index([unique_id])
  @@index([owner_user_id, is_default])
  @@index([deleted_at])
  @@map("profiles")
}

model ProfileMembership {
  id         String         @id @default(uuid()) @db.Uuid
  user_id    String         @db.Uuid
  profile_id String         @db.Uuid
  role       MembershipRole @default(owner)
  created_at DateTime       @default(now()) @db.Timestamptz(6)
  updated_at DateTime       @updatedAt @db.Timestamptz(6)
  profile    Profile        @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, profile_id])
  @@index([profile_id])
  @@index([user_id])
  @@map("profile_memberships")
}

model ProfileTab {
  id            String   @id @default(uuid()) @db.Uuid
  owner_user_id String   @db.Uuid
  profile_id    String   @db.Uuid
  display_name  String?  @db.VarChar(255)
  is_active     Boolean  @default(true)
  sort_order    Int      @default(0)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)
  owner         User     @relation(fields: [owner_user_id], references: [id], onDelete: Cascade)
  profile       Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@unique([owner_user_id, profile_id])
  @@index([owner_user_id, sort_order])
  @@map("profile_tabs")
}

model ProfileViewPreference {
  id          String   @id @default(uuid()) @db.Uuid
  profile_id  String   @db.Uuid
  view_name   String   @db.VarChar(100)
  preferences Json     @default("{}")
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)
  profile     Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@unique([profile_id, view_name])
  @@map("profile_view_preferences")
}

model UserSetting {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @unique @db.Uuid
  settings   Json     @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model ChildProfile {
  id                    String               @id @default(uuid()) @db.Uuid
  parent_profile_id     String               @db.Uuid
  parent_user_id        String?              @db.Uuid
  auth_user_id          String?              @db.Uuid
  first_name            String?              @db.VarChar(100)
  last_name             String?              @db.VarChar(100)
  display_name          String?              @db.VarChar(255)
  name                  String?              @db.VarChar(255)
  email                 String?              @db.VarChar(320)
  username              String?              @unique @db.VarChar(100)
  pin_hash              String?
  pin_length            Int                  @default(4)
  birth_date            DateTime?            @db.Date
  gender                String?              @db.VarChar(50)
  avatar_url            String?
  profile_level         String               @default("beginner") @db.VarChar(50)
  family_role           ChildFamilyRole      @default(child)
  points_balance        Int                  @default(0)
  cash_balance          Decimal              @default(0) @db.Decimal(10, 2)
  stars_balance         Int                  @default(0)
  stars_pending         Int                  @default(0)
  last_login_at         DateTime?            @db.Timestamptz(6)
  failed_login_attempts Int                  @default(0)
  locked_until          DateTime?            @db.Timestamptz(6)
  is_active             Boolean              @default(true)
  metadata              Json                 @default("{}")
  created_at            DateTime             @default(now()) @db.Timestamptz(6)
  updated_at            DateTime             @updatedAt @db.Timestamptz(6)
  deleted_at            DateTime?            @db.Timestamptz(6)
  unique_id             String               @unique @db.VarChar(20)
  allowance_schedules   AllowanceSchedule[]
  achievements          ChildAchievement[]
  login_audit_logs      ChildLoginAuditLog[]
  parent_profile        Profile              @relation(fields: [parent_profile_id], references: [id], onDelete: Cascade)
  parent_user           User?                @relation("ChildParentUser", fields: [parent_user_id], references: [id])
  child_transactions    ChildTransaction[]
  financial_goals       FinancialGoal[]
  parent_access_grants  ParentAccessGrant[]
  profile_invitations   ProfileInvitation[]
  profile_shares        ProfileShare[]
  reward_redemptions    RewardRedemption[]
  rewards               Reward[]             @relation("RewardAssignedChild")
  rewards_redeemed      Reward[]             @relation("RewardRedeemedChild")
  task_completions      TaskCompletion[]
  task_assignments      TaskAssignment[]
  tasks                 Task[]

  @@index([parent_profile_id])
  @@index([parent_user_id])
  @@index([unique_id])
  @@index([deleted_at])
  @@map("child_profiles")
}

model ParentAccessGrant {
  id                String       @id @default(uuid()) @db.Uuid
  child_profile_id  String       @db.Uuid
  parent_profile_id String       @db.Uuid
  granted_by_id     String?      @db.Uuid
  role              String       @default("co_parent") @db.VarChar(50)
  is_active         Boolean      @default(true)
  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  revoked_at        DateTime?    @db.Timestamptz(6)
  child_profile     ChildProfile @relation(fields: [child_profile_id], references: [id], onDelete: Cascade)
  granted_by        User?        @relation("ParentAccessGrantedBy", fields: [granted_by_id], references: [id])
  parent_profile    Profile      @relation(fields: [parent_profile_id], references: [id], onDelete: Cascade)

  @@unique([child_profile_id, parent_profile_id])
  @@index([parent_profile_id])
  @@map("parent_access_grants")
}

model ProfileInvitation {
  id                    String           @id @default(uuid()) @db.Uuid
  child_profile_id      String           @db.Uuid
  invited_email         String           @db.VarChar(320)
  invitation_token      String           @unique @db.VarChar(255)
  invitation_expires_at DateTime         @db.Timestamptz(6)
  invited_by_profile_id String           @db.Uuid
  status                InvitationStatus @default(pending)
  created_at            DateTime         @default(now()) @db.Timestamptz(6)
  accepted_at           DateTime?        @db.Timestamptz(6)
  child_profile         ChildProfile     @relation(fields: [child_profile_id], references: [id], onDelete: Cascade)
  invited_by_profile    Profile          @relation("ProfileInvitationsSent", fields: [invited_by_profile_id], references: [id], onDelete: Cascade)

  @@index([child_profile_id])
  @@index([invited_email])
  @@index([invited_by_profile_id])
  @@index([status, invitation_expires_at])
  @@map("profile_invitations")
}

model ProfileShare {
  id                     String                 @id @default(uuid()) @db.Uuid
  child_profile_id       String                 @db.Uuid
  shared_with_profile_id String                 @db.Uuid
  granted_by_profile_id  String                 @db.Uuid
  is_active              Boolean                @default(true)
  created_at             DateTime               @default(now()) @db.Timestamptz(6)
  revoked_at             DateTime?              @db.Timestamptz(6)
  permission_level       ProfileSharePermission @default(view_only)
  child_profile          ChildProfile           @relation(fields: [child_profile_id], references: [id], onDelete: Cascade)
  granted_by_profile     Profile                @relation("ProfileShareGrantedBy", fields: [granted_by_profile_id], references: [id])
  shared_with_profile    Profile                @relation("ProfileShareReceivedBy", fields: [shared_with_profile_id], references: [id], onDelete: Cascade)

  @@unique([child_profile_id, shared_with_profile_id])
  @@index([shared_with_profile_id])
  @@index([is_active])
  @@map("profile_shares")
}

model ChartOfAccountsTemplate {
  id             String               @id @default(uuid()) @db.Uuid
  account_number Int                  @unique
  account_name   String               @db.VarChar(255)
  display_name   String?              @db.VarChar(255)
  class          AccountClass
  account_type   String?              @db.VarChar(100)
  parent_number  Int?
  is_system      Boolean              @default(true)
  icon           String?              @db.VarChar(100)
  color          String?              @db.VarChar(32)
  created_at     DateTime             @default(now()) @db.Timestamptz(6)
  account_detail String?              @db.VarChar(100)
  sort_order     Int                  @default(0)
  is_editable    Boolean              @default(true)
  user_accounts  UserChartOfAccount[]

  @@index([class, sort_order])
  @@map("chart_of_accounts_templates")
}

model UserChartOfAccount {
  id                                      String                   @id @default(uuid()) @db.Uuid
  profile_id                              String                   @db.Uuid
  template_account_number                 Int?
  account_number                          Int?
  account_name                            String?                  @db.VarChar(255)
  display_name                            String?                  @db.VarChar(255)
  class                                   AccountClass
  account_type                            String?                  @db.VarChar(100)
  parent_account_id                       String?                  @db.Uuid
  institution_name                        String?                  @db.VarChar(255)
  account_mask                            String?                  @db.VarChar(32)
  current_balance                         Decimal                  @default(0) @db.Decimal(14, 2)
  available_balance                       Decimal?                 @db.Decimal(14, 2)
  opening_balance                         Decimal?                 @db.Decimal(14, 2)
  include_in_cash_balance                 Boolean                  @default(false)
  is_active                               Boolean                  @default(true)
  is_system                               Boolean                  @default(false)
  icon                                    String?                  @db.VarChar(100)
  color                                   String?                  @db.VarChar(32)
  metadata                                Json                     @default("{}")
  created_at                              DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                              DateTime                 @updatedAt @db.Timestamptz(6)
  deleted_at                              DateTime?                @db.Timestamptz(6)
  account_detail                          String?                  @db.VarChar(100)
  is_user_created                         Boolean                  @default(false)
  opening_balance_locked                  Boolean                  @default(false)
  bank_current_balance                    Decimal?                 @db.Decimal(14, 2)
  bank_available_balance                  Decimal?                 @db.Decimal(14, 2)
  bank_balance_synced_at                  DateTime?                @db.Timestamptz(6)
  plaid_import_start_date                 DateTime?                @db.Date
  reconciliation_variance                 Decimal?                 @default(0) @db.Decimal(14, 2)
  last_reconciled_at                      DateTime?                @db.Timestamptz(6)
  budgets                                 Budget[]
  linked_goals                            FinancialGoal[]
  journal_entry_lines                     JournalEntryLine[]
  plaid_account                           PlaidAccount?
  recurring_schedules_as_bank_account     RecurringSchedule[]      @relation("RecurringScheduleBankAccount")
  recurring_schedules_as_category_account RecurringSchedule[]      @relation("RecurringScheduleCategoryAccount")
  transaction_rules                       TransactionRule[]
  transaction_splits                      TransactionSplit[]
  bank_transactions                       Transaction[]            @relation("TransactionBankAccount")
  category_transactions                   Transaction[]            @relation("TransactionCategoryAccount")
  parent_account                          UserChartOfAccount?      @relation("AccountHierarchy", fields: [parent_account_id], references: [id])
  child_accounts                          UserChartOfAccount[]     @relation("AccountHierarchy")
  profile                                 Profile                  @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  template                                ChartOfAccountsTemplate? @relation(fields: [template_account_number], references: [account_number])

  @@index([profile_id])
  @@index([profile_id, is_active])
  @@index([parent_account_id])
  @@index([deleted_at])
  @@map("user_chart_of_accounts")
}

model PlaidItem {
  id                  String         @id @default(uuid()) @db.Uuid
  profile_id          String         @db.Uuid
  plaid_item_id       String         @unique @db.VarChar(255)
  access_token        String
  institution_id      String?        @db.VarChar(255)
  institution_name    String?        @db.VarChar(255)
  products            Json           @default("[]")
  available_products  Json           @default("[]")
  billed_products     Json           @default("[]")
  transactions_cursor String?
  status              String         @default("active") @db.VarChar(50)
  last_synced_at      DateTime?      @db.Timestamptz(6)
  error               Json?
  metadata            Json           @default("{}")
  created_at          DateTime       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime       @updatedAt @db.Timestamptz(6)
  deleted_at          DateTime?      @db.Timestamptz(6)
  accounts            PlaidAccount[]
  profile             Profile        @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([profile_id])
  @@index([profile_id, status])
  @@index([deleted_at])
  @@map("plaid_items")
}

model PlaidAccount {
  id                       String              @id @default(uuid()) @db.Uuid
  profile_id               String              @db.Uuid
  plaid_item_id            String              @db.Uuid
  plaid_account_id         String              @unique @db.VarChar(255)
  user_chart_account_id    String?             @unique @db.Uuid
  name                     String              @db.VarChar(255)
  official_name            String?             @db.VarChar(255)
  mask                     String?             @db.VarChar(32)
  type                     String?             @db.VarChar(100)
  subtype                  String?             @db.VarChar(100)
  verification_status      String?             @db.VarChar(100)
  current_balance          Decimal?            @db.Decimal(14, 2)
  available_balance        Decimal?            @db.Decimal(14, 2)
  iso_currency_code        String?             @db.VarChar(12)
  unofficial_currency_code String?             @db.VarChar(32)
  is_active                Boolean             @default(true)
  metadata                 Json                @default("{}")
  created_at               DateTime            @default(now()) @db.Timestamptz(6)
  updated_at               DateTime            @updatedAt @db.Timestamptz(6)
  deleted_at               DateTime?           @db.Timestamptz(6)
  plaid_item               PlaidItem           @relation(fields: [plaid_item_id], references: [id], onDelete: Cascade)
  profile                  Profile             @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  user_chart_account       UserChartOfAccount? @relation(fields: [user_chart_account_id], references: [id])

  @@index([profile_id])
  @@index([plaid_item_id])
  @@index([user_chart_account_id])
  @@index([deleted_at])
  @@map("plaid_accounts")
}

model Transaction {
  id                    String                    @id @default(uuid()) @db.Uuid
  profile_id            String                    @db.Uuid
  bank_account_id       String?                   @db.Uuid
  category_account_id   String?                   @db.Uuid
  contact_id            String?                   @db.Uuid
  journal_entry_id      String?                   @db.Uuid
  date                  DateTime                  @db.Date
  posted_date           DateTime?                 @db.Date
  description           String                    @db.VarChar(500)
  original_description  String?                   @db.VarChar(500)
  amount                Decimal                   @db.Decimal(14, 2)
  transaction_type      TransactionType?
  status                TransactionStatus         @default(pending)
  memo                  String?
  check_number          String?                   @db.VarChar(50)
  source                String?                   @db.VarChar(100)
  external_id           String?                   @db.VarChar(255)
  imported_at           DateTime?                 @db.Timestamptz(6)
  metadata              Json                      @default("{}")
  created_at            DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                  @updatedAt @db.Timestamptz(6)
  deleted_at            DateTime?                 @db.Timestamptz(6)
  goal_contributions    GoalContribution?
  source_journal_entry  JournalEntry?             @relation("JournalEntrySourceTransaction")
  calendar_occurrence   RecurringOccurrence?      @relation("OccurrenceTransaction")
  splits                TransactionSplit[]
  bank_account          UserChartOfAccount?       @relation("TransactionBankAccount", fields: [bank_account_id], references: [id])
